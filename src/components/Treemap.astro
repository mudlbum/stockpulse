---
/**
 * Squarified treemap, laid out at build time and emitted as inline SVG.
 * Three return windows are rendered as three <g> layers; the toggle swaps
 * which layer is visible, so switching windows costs nothing at runtime and
 * the whole thing still works with JS disabled (the 1d layer shows).
 */
import type { Locale, MarketId } from '../config';
import { UI } from '../i18n/ui';
import { fmtCap, fmtPct } from '../lib/format';
import { divergingFill, divergingLegend, squarify } from '../lib/viz';
import type { Sector } from '../lib/types';

interface Props {
  lang: Locale;
  market: MarketId;
  sectors: Sector[];
  currency: string;
}
const { lang, market, sectors, currency } = Astro.props;
const t = UI[lang];

const W = 1000;
const H = 560;
const rects = squarify(sectors, (s) => s.marketCap, { x: 0, y: 0, w: W, h: H });

const windows = [
  { key: 'return1d' as const, label: t.sectors.w1d },
  { key: 'return5d' as const, label: t.sectors.w5d },
  { key: 'return20d' as const, label: t.sectors.w20d },
];

/** Colour domain per window so a 20-day move is not clipped by a 1-day scale. */
const domains = Object.fromEntries(
  windows.map((w) => [w.key, Math.max(0.5, ...sectors.map((s) => Math.abs(s[w.key])))]),
) as Record<'return1d' | 'return5d' | 'return20d', number>;

const name = (s: Sector) => (lang === 'ko' ? s.nameKo : s.name);

/* SVGElement does not implement the `hidden` IDL property, so the layer
   toggle below drives inline `display` instead of `el.hidden`. */
---

<div class="treemap" data-treemap={market}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${t.sectors.title} — ${t.common.market[market]}`}>
    {
      windows.map((w, wi) => (
        <g data-window={w.key} style={wi === 0 ? undefined : 'display:none'}>
          {rects.map((r) => {
            const s = r.item;
            const c = divergingFill(s[w.key], domains[w.key]);
            const showLabel = r.w > 74 && r.h > 40;
            const showValue = r.w > 74 && r.h > 58;
            return (
              <g>
                <title>
                  {name(s)} · {fmtCap(s.marketCap, currency, lang)} · {fmtPct(s[w.key], 2, lang)}
                </title>
                <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={c.fill} />
                {showLabel && (
                  <text x={r.x + 9} y={r.y + 22} fill={c.text} font-size="15" font-weight="650">
                    {name(s).length > Math.floor(r.w / 8) ? name(s).slice(0, Math.max(3, Math.floor(r.w / 8))) + '…' : name(s)}
                  </text>
                )}
                {showValue && (
                  <text x={r.x + 9} y={r.y + 42} fill={c.text} font-size="14" font-weight="700" style="font-variant-numeric:tabular-nums">
                    {s[w.key] >= 0 ? '▲' : '▼'} {fmtPct(s[w.key], 2, lang)}
                  </text>
                )}
                {showValue && r.h > 78 && (
                  <text x={r.x + 9} y={r.y + 60} fill={c.text} font-size="11.5" opacity="0.92">
                    {fmtCap(s.marketCap, currency, lang)}
                  </text>
                )}
              </g>
            );
          })}
        </g>
      ))
    }
  </svg>

  {
    windows.map((w, wi) => (
      <div class="tm-legend" data-legend={w.key} hidden={wi !== 0}>
        <span style="margin-inline-end:.4rem;">
          {t.sectors.legend} ({w.label})
        </span>
        {divergingLegend(domains[w.key]).map((sw) => (
          <span class="sw" style={`background:${sw.fill};color:${sw.text}`}>
            {fmtPct(sw.value, 0, lang)}
          </span>
        ))}
      </div>
    ))
  }
</div>
