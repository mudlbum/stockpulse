---
import { sparkline } from '../lib/viz';

interface Props {
  values: number[];
  label?: string;
  width?: number;
  height?: number;
  class?: string;
}
const { values, label, width = 100, height = 28, class: cls = '' } = Astro.props;
const s = sparkline(values, width, height);
---

{
  s && (
    <svg
      class={`spark ${s.rising ? 'rise' : 'fall'} ${cls}`}
      viewBox={`0 0 ${width} ${height}`}
      preserveAspectRatio="none"
      role="img"
      aria-label={label}
    >
      <path class="area" d={s.area} />
      <path class="line" d={s.line} />
    </svg>
  )
}
