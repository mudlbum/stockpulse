---
/**
 * Diverging bar per factor z-score. Zero sits at the centre line, so a name
 * that ranks on one strong factor looks different from one that ranks on five
 * mediocre ones — which is the whole point of showing this.
 */
import type { Locale } from '../config';
import { UI } from '../i18n/ui';
import { fmtNum } from '../lib/format';
import type { FactorValue } from '../lib/types';

interface Props {
  lang: Locale;
  factors: Record<string, FactorValue>;
}
const { lang, factors } = Astro.props;
const t = UI[lang];

/** z of ±3 fills the half-bar; beyond that it clamps. */
const CLAMP = 3;

/** camelCase factor keys are pipeline identifiers — make them readable. */
function humanize(key: string): string {
  return key
    .replace(/^_/, '')
    .replace(/([A-Z])/g, ' $1')
    .replace(/^./, (c) => c.toUpperCase())
    .trim();
}

/**
 * Korean labels for the pipeline's factor identifiers.
 *
 * `humanize` turns `capitalEfficiency` into "Capital Efficiency", which is the
 * right answer in English and leaves the Korean board's factor breakdown — the
 * one panel a reader opens to see *why* a name ranked — entirely in English.
 * The wording here matches the terms already used in the Korean methodology
 * summary and research notes (성장의 질, 재투자 여력, 거래량비율), so the panel
 * and the prose explaining it agree. Unmapped keys fall back to `humanize`,
 * so a new factor degrades to English rather than to a blank label.
 */
const FACTOR_KO: Record<string, string> = {
  relativeVolume: '거래량비율',
  gapQuality: '갭 품질',
  newsSentiment: '뉴스 감성',
  volatilityExpansion: '변동성 확대',
  trendPosition: '추세 위치',
  trendAlignment: '추세 정렬',
  fundamentalMomentum: '펀더멘털 모멘텀',
  earningsDrift: '실적 드리프트',
  moneyFlow: '자금 흐름',
  sectorStrength: '섹터 강도',
  growthQuality: '성장의 질',
  capitalEfficiency: '자본 효율성',
  cashGeneration: '현금 창출력',
  valuation: '밸류에이션',
  fScore: 'F 스코어',
  moatStrength: '해자 강도',
  cashFlowDurability: '현금흐름 지속성',
  reinvestmentRunway: '재투자 여력',
  balanceSheetStrength: '재무구조 건전성',
  shareholderYield: '주주환원 수익률',
};

const factorLabel = (key: string): string =>
  (lang === 'ko' && FACTOR_KO[key.replace(/^_/, '')]) || humanize(key);

const entries = Object.entries(factors || {}).filter(([k]) => !k.startsWith('_'));
---

<div class="factors">
  <div class="factor factor-head">
    <span class="fname muted small">{t.home.factorBreakdown}</span>
    <span class="muted small" style="text-align:center;">− 0 +</span>
    <span class="fz muted small">{t.home.factorZ}</span>
  </div>
  {
    entries.map(([key, val]) => {
      const z = Number(val?.z ?? 0);
      const pct = Math.min(Math.abs(z) / CLAMP, 1) * 50;
      return (
        <div class="factor">
          <span class="fname" title={`${t.home.factorRaw}: ${fmtNum(val?.raw, 3, lang)}`}>
            {factorLabel(key)}
          </span>
          <span class="fbar" role="img" aria-label={`${factorLabel(key)} ${t.home.factorZ} ${fmtNum(z, 2, lang)}`}>
            {z >= 0 ? (
              <i class="pos" style={`width:${pct}%`} />
            ) : (
              <i class="neg" style={`width:${pct}%`} />
            )}
          </span>
          <span class={`fz ${z > 0 ? 'up' : z < 0 ? 'down' : 'flat'}`}>
            {z > 0 ? '+' : z < 0 ? '−' : ''}
            {fmtNum(Math.abs(z), 2, lang)}
          </span>
        </div>
      );
    })
  }
</div>

<style>
  .factor-head {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.15rem;
  }
</style>
