---
import { HORIZONS, type Locale } from '../config';
import { UI } from '../i18n/ui';
import { fmtDate, fmtNum, fmtRatioPct } from '../lib/format';
import { HORIZON_INK } from '../lib/theme';
import type { Board } from '../lib/types';
import { boardSlug } from '../i18n/horizon-pages';
import { pageHref } from '../lib/paths';
import StockRow from './StockRow.astro';
import ComplianceNotice from './ComplianceNotice.astro';
import ScrollArea from './ScrollArea.astro';

interface Props {
  lang: Locale;
  board: Board;
  selected: boolean;
  /** On a per-horizon landing page this is the only board, so it is not a
      tabpanel and is never hidden. */
  standalone?: boolean;
  /** Heading level for the board title — h2 on the home page, h3 when the
      landing page already owns the h2 slot. */
  headingId?: string;
}
const { lang, board, selected, standalone = false, headingId } = Astro.props;
const t = UI[lang];
const h = HORIZONS.find((x) => x.id === board.horizon)!;
const ink = HORIZON_INK[board.horizon];
const boardId = `${board.market}-${board.horizon}`.toLowerCase();

const styleVars = `--h-accent:${h.accent};--h-accent-dark:${h.accentDark};--h-ink:${ink.light};--h-ink-dark:${ink.dark}`;

/* An empty board is expected, not broken. The pipeline states the reason in
   both languages; fall back to the generic line only if it is absent. */
const emptyText = board.emptyReason?.[lang] ?? t.home.emptyBoard;
---

<section
  class="board-panel js-panel"
  id={`board-${boardId}`}
  data-board={`${board.market}/${board.horizon}`}
  data-horizon={board.horizon}
  style={styleVars}
  hidden={standalone ? undefined : !selected}
  role={standalone ? undefined : 'tabpanel'}
  tabindex={standalone ? undefined : '0'}
  aria-labelledby={standalone ? undefined : `tab-${board.horizon}`}
>
  {/* Visible, not visually-hidden: "United States · Ultra Short" is the most
      query-relevant heading on the page and hiding it threw that away. */}
  <h2 id={headingId ?? `bh-${boardId}`} class="board-heading">
    {t.common.market[board.market]} · {h.label[lang]}
    <span class="board-heading-win">{h.window[lang]}</span>
  </h2>

  <div class="board-meta">
    <span class="metric">
      <span class="k">{t.home.asOf}</span>
      <span class="v" data-live="asOf">{fmtDate(board.asOf, lang)}</span>
    </span>
    <span class="metric" title={t.home.turnoverHelp}>
      <span class="k">{t.home.turnover}</span>
      <span class="v" data-live="turnover">{fmtRatioPct(board.turnover30d, 0, lang)}</span>
    </span>
    <span class="metric">
      <span class="k">{t.home.horizon}</span>
      <span class="v" style="color:var(--accent-ink)">{h.label[lang]} · {h.window[lang]}</span>
    </span>
    <span class="metric">
      <span class="k">{t.home.columns.rank}</span>
      <span class="v">{fmtNum(board.rows.length, 0, lang)}</span>
    </span>
    {!standalone && (
      <span class="metric">
        <a href={pageHref(lang, boardSlug(board.market, board.horizon))}>{t.home.boardPermalink} →</a>
      </span>
    )}
    <p class="eod">{t.home.eodNote}</p>
  </div>

  <p class="blurb">{h.blurb[lang]}</p>

  {board.sampleWarning && <div class="notice notice-warn" style="margin-top:.8rem;">{t.home.sampleWarning}</div>}

  <ComplianceNotice lang={lang} />

  {
    board.rows.length === 0 ? (
      <div class="empty-state" role="note">
        <span class="empty-mark" aria-hidden="true">
          &#9432;
        </span>
        <div class="empty-body">
          <h3>{t.home.emptyBoardHeading}</h3>
          <p class="empty-why">
            <span class="empty-k">{t.home.emptyBoardWhy}</span>
            {emptyText}
          </p>
          <p class="empty-foot">
            {t.home.emptyBoardFooter}
            {board.emptyReason && (
              <>
                {' '}
                <span class="empty-k">{t.home.emptyBoardCode}</span>
                <code>{board.emptyReason.code}</code>
              </>
            )}
          </p>
        </div>
      </div>
    ) : (
      <ScrollArea lang={lang} class="board-wrap" label={t.home.scrollRegion}>
        {/* Long-horizon boards carry no price stop, so the levels column holds
            the thesis-invalidation conditions instead and needs the room. */}
        <table class={`board${h.hasStop ? '' : ' board-nostop'}`}>
          <thead>
            <tr>
              <th class="th-rank" scope="col">{t.home.columns.rank}</th>
              <th class="th-stock" scope="col">{t.home.columns.stock}</th>
              <th class="th-price" scope="col">{t.home.columns.price}</th>
              <th class="th-spark" scope="col">{t.home.columns.trend}</th>
              <th class="th-score" scope="col">{t.home.columns.score}</th>
              <th class="th-levels" scope="col">{t.home.columns.levels}</th>
              <th class="th-targets" scope="col">{t.home.columns.targets}</th>
              <th class="th-risk" scope="col">{t.home.columns.risk}</th>
              <th class="th-cat" scope="col">{t.home.columns.catalyst}</th>
              <th class="th-more" scope="col"><span class="visually-hidden">{t.home.columns.detail}</span></th>
            </tr>
          </thead>
          <tbody>
            {board.rows.map((row) => (
              <StockRow lang={lang} row={row} horizon={board.horizon} boardId={boardId} />
            ))}
          </tbody>
        </table>
      </ScrollArea>
    )
  }

  {
    board.justMissed.length > 0 && (
      <div class="just-missed">
        <div class="section-head">
          <h3>{t.home.justMissed}</h3>
          <p>{t.home.justMissedIntro}</p>
        </div>
        <ul class="jm-list">
          {board.justMissed.map((jm) => (
            <li class="jm-item">
              <span class="jm-tic">{jm.ticker}</span>
              <span class="jm-name">{jm.name}</span>
              <span class="jm-score">{t.home.columns.score} {fmtNum(jm.score, 1, lang)}</span>
              <span class="chip chip-warn">
                {t.home.displacedBy[jm.displacedBy as keyof typeof t.home.displacedBy] ?? jm.displacedBy}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
