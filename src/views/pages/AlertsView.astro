---
import type { Locale } from '../../config';
import { UI } from '../../i18n/ui';
import { absolute, href } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import PageEssay from '../../components/PageEssay.astro';
import { ESSAYS } from '../../i18n/page-essays';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = UI[lang];

const feeds = [
  { label: t.alerts.jsonLink, url: href('data/rankings.json'), type: 'application/json' },
  { label: t.alerts.newsLink, url: href('data/news.json'), type: 'application/json' },
  { label: t.alerts.perfLink, url: href('data/performance.json'), type: 'application/json' },
  { label: t.alerts.rssLink, url: absolute('rss.xml'), type: 'application/rss+xml' },
];
---

{/* Announces a feature that does not exist. Indexing a page whose headline
    promise is unavailable is the definition of a thin result, so it stays out
    of the index (and out of the sitemap) until alerts actually ship. */}
<Base lang={lang} page="alerts" title={t.seo.alerts.title} description={t.seo.alerts.description} noindex={true}>
  <div class="wrap wrap-narrow">
    <div class="page-head">
      <h1>{t.alerts.title}</h1>
      <p class="lede">{t.alerts.intro}</p>
    </div>

    <section aria-labelledby="today-h">
      <div class="section-head">
        <h2 id="today-h">{t.alerts.todayHeading}</h2>
      </div>
      <p>{t.alerts.todayBody}</p>
      <ul class="feed-list">
        {
          feeds.map((f) => (
            <li>
              <a href={f.url}>{f.label}</a>
              <code>{f.type}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="planned-h">
      <div class="section-head">
        <h2 id="planned-h">{t.alerts.plannedHeading}</h2>
      </div>
      <p>{t.alerts.plannedBody}</p>
    </section>

    <section aria-labelledby="form-h">
      <div class="section-head">
        <h2 id="form-h">{t.alerts.formHeading}</h2>
      </div>

      <div class="notice notice-warn" role="note" style="margin-bottom:1rem;">
        <p style="margin:0;">{t.alerts.formNote}</p>
      </div>

      {/* Deliberately inert: no action, no method, no handler, disabled submit.
          A form that appears to accept an address and silently discards it is
          worse than no form at all. */}
      <form class="panel" aria-describedby="form-note-text" onsubmit="return false;">
        <div class="field-row">
          <div class="field" style="flex:1 1 260px;">
            <label for="a-email">{t.alerts.emailLabel}</label>
            <input
              type="email"
              id="a-email"
              name="email"
              placeholder={t.alerts.emailPlaceholder}
              disabled
              aria-disabled="true"
            />
          </div>
          <div class="field" style="flex:0 0 auto;">
            <button type="submit" class="btn" disabled aria-disabled="true">{t.alerts.submit}</button>
          </div>
        </div>
        <p id="form-note-text" class="small muted" style="margin:.7rem 0 0;">{t.alerts.contact}</p>
      </form>
    </section>
  
    <PageEssay lang={lang} heading={ESSAYS.alerts[lang].heading} sections={ESSAYS.alerts[lang].sections} />
</div>
</Base>

<style>
  .feed-list {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.4rem;
  }
  .feed-list li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    padding: 0.55rem 0.75rem;
  }
</style>
